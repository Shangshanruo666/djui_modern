diff --git a/src/pc/djui/djui_rect.h b/src/pc/djui/djui_rect.h
--- a/src/pc/djui/djui_rect.h
+++ b/src/pc/djui/djui_rect.h
@@ -5,6 +5,23 @@ struct DjuiRect {
     struct DjuiBase base;
 };
 
+/*
+ * djui_modern 矩形渲染接管点。
+ *
+ * djui_rect_render() 在函数入口调用它。返回 true 表示现代化实现已绘制完成
+ * （此时原版实现被跳过），返回 false 表示按原版绘制。
+ *
+ * 它是**弱符号**：定义侧（djui_rect.c 里的空兜底）带
+ * `__attribute__((weak))`，djui_modern 存在时其强定义在链接期覆盖它。
+ *
+ * ⚠ 这里**故意不加** weak 属性 —— 同类钩子（`djui_gfx.h` 的
+ *   `djui_modern_note_font_size` / `djui_modern_note_text_base`）有详细说明：
+ *   属性若出现在声明上，会随 `djui.h` 传播到所有包含它的 TU，
+ *   把 djui_modern 侧本该是强符号的定义也**传染成 weak**，
+ *   导致链接器在两个 weak 中任选一个（实测会选中原版空实现）→ 接管静默失效。
+ */
+bool djui_modern_rect_override(struct DjuiBase* base);
+
 bool djui_rect_render(struct DjuiBase* base);
 struct DjuiRect* djui_rect_create(struct DjuiBase* parent);
 struct DjuiRect* djui_rect_container_create(struct DjuiBase* parent, f32 height);
