+/*
+ * RGBA32 纹理直接透传给后端，其余格式需要展开为 RGBA32。
+ * 展开缓冲按实际纹素数量分配，避免固定上限拒绝大尺寸纹理。
+ */
+static uint8_t* sTexConvBuf = NULL;
+static uint32_t sTexConvCap = 0;
+
+static bool tex_conv_reserve(uint32_t pixels) {
+    const uint64_t need = (uint64_t)pixels * 4u;
+    if (need <= sTexConvCap) { return true; }
+    uint8_t* grown = realloc(sTexConvBuf, (size_t)need);
+    if (grown == NULL) { return false; }
+    sTexConvBuf = grown;
+    sTexConvCap = (uint32_t)need;
+    return true;
+}
