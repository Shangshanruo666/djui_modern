diff --git a/src/pc/djui/djui.c b/src/pc/djui/djui.c
--- a/src/pc/djui/djui.c
+++ b/src/pc/djui/djui.c
@@ -20,6 +20,7 @@
 #include "djui_hud_utils.h"
 #include "engine/math_util.h"
 #include "pc/utils/misc.h"
+#include "pc/djui_modern/djui_modern.h"
 
 static Gfx* sSavedDisplayListHead = NULL;
 
@@ -66,6 +67,9 @@ void djui_shutdown(void) {
     djui_ctx_display_destroy();
     djui_lua_profiler_destroy();
 
+    // 释放字形图集、字体数据并还原被钩住的渲染原语。
+    djui_modern_shutdown();
+
     gDjuiShuttingDown = false;
     sDjuiInited = false;
 }
@@ -90,6 +94,17 @@ void djui_init(void) {
     gDjuiRoot = djui_root_create();
     sDjuiRootBehind = djui_root_create();
 
+    /*
+     * 现代化 UI 皮肤层。钩子安装失败时会自动保持原版界面。
+     *
+     * ⚠⚠ 必须在**本函数里第一次 `djui_text_create()` 之前**调用：
+     *   `djui_text_create()` 把 `gDjuiFonts[slot]` 的**当前指针**存进 `text->font`，
+     *   而模块是在初始化时替换 `gDjuiFonts[]` 的 —— 先创建的文字节点会一直持有
+     *   **原版字体指针**（真机表现："玩家列表时而矢量字体、时而原版字体"：
+     *   面板在下面被预先创建，只有**重开面板**时新建的节点才拿到矢量字体）。
+     */
+    djui_modern_init();
+
     gDjuiPauseOptions = djui_text_create(&sDjuiRootBehind->base, DLANG(MISC, R_BUTTON));
     djui_base_set_size_type(&gDjuiPauseOptions->base, DJUI_SVT_RELATIVE, DJUI_SVT_ABSOLUTE);
     djui_base_set_size(&gDjuiPauseOptions->base, 1.0f, 32);
@@ -180,6 +195,10 @@ void djui_reset_hud_params(void) {
 
 void djui_render(void) {
     if (!sDjuiInited || gDjuiDisabled) { return; }
+    // 现代化 UI 皮肤层：每帧渲染前重置顶点池、推进字形缓存并应用主题。
+    // 若未启用/未安装，这里是空操作。
+    djui_modern_pre_render();
+
     djui_reset_hud_params();
 
     sSavedDisplayListHead = gDisplayListHead;
@@ -218,6 +237,9 @@ void djui_render(void) {
     render_touch_controls();
 #endif
     djui_base_render(&gDjuiConsole->base);
+    // 现代化 UI 皮肤层的帧末诊断：扫描本帧 display list 的矩阵平衡。
+    djui_modern_post_render();
+
     djui_interactable_update();
     djui_gfx_displaylist_end();
 }
